# Staging stack — copy to infra/.env.staging before `docker compose up`
# Do not commit infra/.env.staging (real secrets).

# Backend
PORT=4000
APP_VERSION=0.0.1
DATABASE_URL=postgresql://dogrsc:dogrsc@postgres:5432/dogrsc
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=dogrsc_minio
S3_SECRET_KEY=dogrsc_minio_secret
S3_BUCKET=dogrsc-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Production Railway: S3_FORCE_PATH_STYLE=false, CORS_ORIGINS=https://...
# CORS_ORIGINS=
JWT_SECRET=change-me-staging-only
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@dogerescue.org
ADMIN_PASSWORD=changeme-staging-only
STAFF_EMAIL=staff@dogerescue.org
STAFF_PASSWORD=changeme-staff-staging
SYSTEM_USER_EMAIL=system@dogerescue.org
MEDIA_MAX_BYTES=5242880
MEDIA_PRESIGNED_TTL_SECONDS=900
REPORT_MEDIA_UPLOAD_WINDOW_MINUTES=15

# MinIO (must match docker-compose.staging.yml)
MINIO_ROOT_USER=dogrsc_minio
MINIO_ROOT_PASSWORD=dogrsc_minio_secret

# Built into frontend/admin images at build time (browser → host API)
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

# Server-side only (Docker SSR → backend service); set in compose for staging frontend
API_URL=http://backend:4000/api/v1
