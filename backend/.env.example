# Server
PORT=4000
APP_VERSION=0.0.1

# Database (used in later tasks — not required for health scaffold)
DATABASE_URL=postgresql://dogrsc:dogrsc@localhost:5432/dogrsc

# Redis (used in later tasks)
REDIS_URL=redis://localhost:6379

# S3 / MinIO (local dev — see infra/docker-compose.dev.yml)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dogrsc_minio
S3_SECRET_KEY=dogrsc_minio_secret
S3_BUCKET=dogrsc-media
S3_REGION=us-east-1
# true for local MinIO; false for Railway Bucket / virtual-hosted S3
S3_FORCE_PATH_STYLE=true

# Comma-separated admin/frontend URLs for production (optional in dev)
# CORS_ORIGINS=https://your-frontend.up.railway.app,https://your-admin.up.railway.app

# Auth (change JWT_SECRET in production)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@dogerescue.org
ADMIN_PASSWORD=changeme-dev-only
STAFF_EMAIL=staff@dogerescue.org
STAFF_PASSWORD=changeme-staff-dev

# Media upload
MEDIA_MAX_BYTES=5242880
MEDIA_PRESIGNED_TTL_SECONDS=900
REPORT_MEDIA_UPLOAD_WINDOW_MINUTES=15
SYSTEM_USER_EMAIL=system@dogerescue.org

# Logo upload processing (site branding)
LOGO_TRIM_ENABLED=true
LOGO_TRIM_THRESHOLD=15
LOGO_MAX_WIDTH=320
LOGO_MAX_HEIGHT=128
LOGO_MIN_HEIGHT=64

# Dev/test keys always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA
# Set CAPTCHA_SKIP=true only in e2e / local automation
# CAPTCHA_SKIP=true
